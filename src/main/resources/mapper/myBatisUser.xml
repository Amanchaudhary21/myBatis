<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybatis.mapper.MyBatisUserMapper">

    <select id="findAll"
            resultType="com.example.mybatis.entity.MybatisUser">

        SELECT * FROM mybatis_user;

    </select>
    <select id="findById"
            resultType="com.example.mybatis.entity.MybatisUser">

        SELECT id,name FROM mybatis_user where id=#{id};

    </select>



</mapper>